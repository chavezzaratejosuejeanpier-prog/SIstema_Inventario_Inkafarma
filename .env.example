
SECRET_KEY=cambia-esta-clave-en-produccion

# Formato para PostgreSQL:
# DATABASE_URL=postgresql://usuario:password@localhost:5432/inkafarma_db
DATABASE_URL=postgresql://postgres:12345@localhost:5432/inkafarma_db

# Correo saliente (recuperación de contraseña). Usa una cuenta de Gmail con
# "contraseña de aplicación" (Cuenta de Google > Seguridad > Verificación en
# 2 pasos > Contraseñas de aplicaciones). NO uses tu contraseña normal aquí.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=tu-correo@gmail.com
MAIL_PASSWORD=tu-contraseña-de-aplicacion
MAIL_DEFAULT_SENDER=tu-correo@gmail.com
